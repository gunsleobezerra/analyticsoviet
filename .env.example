# ---- App ----
APP_NAME=analyticsoviet
ENVIRONMENT=dev
LOG_LEVEL=INFO
API_PREFIX=/v1

# ---- HTTP client ----
HTTP_TIMEOUT_SECONDS=20
HTTP_CONNECT_TIMEOUT_SECONDS=10
HTTP_MAX_CONNECTIONS=50
HTTP_MAX_KEEPALIVE_CONNECTIONS=20
HTTP_RETRIES=3
HTTP_RETRY_BACKOFF_SECONDS=0.6
# Residential proxy strongly recommended for Instagram/Facebook.
# PROXY_URL=http://user:pass@host:port

# ---- Cache ----
# memory | redis
CACHE_BACKEND=memory
CACHE_TTL_PROFILE_SECONDS=900
CACHE_TTL_POSTS_SECONDS=900
CACHE_TTL_POST_SECONDS=3600
CACHE_MAX_ENTRIES=5000
REDIS_URL=redis://localhost:6379/0

# ---- Rate limiting (requests per minute, per platform) ----
RATELIMIT_YOUTUBE_PER_MINUTE=60
RATELIMIT_TIKTOK_PER_MINUTE=30
RATELIMIT_INSTAGRAM_PER_MINUTE=20
RATELIMIT_FACEBOOK_PER_MINUTE=15

# ---- Concurrency (max in-flight requests per platform) ----
CONCURRENCY_YOUTUBE=8
CONCURRENCY_TIKTOK=4
CONCURRENCY_INSTAGRAM=3
CONCURRENCY_FACEBOOK=2

# ---- Circuit breaker ----
BREAKER_ENABLED=false
BREAKER_FAILURE_THRESHOLD=5
BREAKER_COOLDOWN_SECONDS=10

# ---- Storage ----
DATABASE_URL=sqlite+aiosqlite:///./data/analyticsoviet.db
ENABLE_HISTORY=true

# ---- Optional official APIs (used as fallback / higher confidence) ----
# YOUTUBE_API_KEY=AIza...
# INSTAGRAM_APP_ID=936619743392459

# ---- Cookies storage backend (local | s3) ----
# Choose 'local' to read from disk, or 's3' to auto-download from any S3-compatible storage.
COOKIES_STORAGE_BACKEND=local
# Local folder where cookies are located (or downloaded to when backend is s3)
COOKIES_DIR=cookies

# ---- S3-compatible Storage (MinIO, Cloudflare R2, Ceph, Wasabi, AWS S3) ----
# Required only if COOKIES_STORAGE_BACKEND=s3:
# S3_ENDPOINT_URL=https://s3.example.com  # or http://localhost:9000 for MinIO
# S3_COOKIES_BUCKET=my-cookies-bucket
# S3_COOKIES_PREFIX=cookies/
# S3_REGION_NAME=us-east-1
# S3_ACCESS_KEY_ID=your-access-key
# S3_SECRET_ACCESS_KEY=your-secret-key
# S3_SESSION_TOKEN=

# ---- Optional explicit cookies files override ----
# COOKIES_YOUTUBE_FILE=cookies/youtube.txt
# COOKIES_TIKTOK_FILE=cookies/tiktok.txt
# COOKIES_INSTAGRAM_FILE=cookies/instagram.txt
# COOKIES_FACEBOOK_FILE=cookies/facebook.txt

# ---- Scraping limits ----
SCRAPE_MAX_URLS=20
SCRAPE_DEFAULT_POSTS=12
